{
  "name": "obsidian-inkwell",
  "version": "0.1.0",
  "description": "Native handwritten notes with ruled paper backgrounds",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian", "handwriting", "apple-pencil", "notes"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.20.0",
    "obsidian": "latest",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.2"
  }
}
